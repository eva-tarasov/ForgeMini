# Do not edit by hand: run scripts/setup.sh, it creates .env, generates the password and asks for the key.
POSTGRES_USER=forge
POSTGRES_PASSWORD=CHANGE_ME_FOR_LOCAL_USE
POSTGRES_DB=forge
POSTGRES_PORT=55432

# --- ForgeMini live run (the key lives ONLY in your local .env; .env is git-ignored) ---
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# FORGE_MODEL_NAME=YOUR_OPENAI_MODEL_NAME
# FORGE_MODEL_TIMEOUT_SECONDS=120      # one LLM call
# FORGE_RUN_TIMEOUT_SECONDS=900        # whole agent run
# FORGE_VERIFY_TIMEOUT_SECONDS=300     # one test-command run inside the Verifier
# FORGE_AGENT_MAX_STEPS=25             # step budget of the agent loop
# FORGE_DATA_DIR=./.forgemini          # patches and transcripts
# FORGE_SANDBOX_IMAGE=python:3.12-slim
