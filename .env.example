# Do not edit by hand: run scripts/setup.sh, it creates .env, generates the password and asks for the key.
POSTGRES_USER=forge
POSTGRES_PASSWORD=CHANGE_ME_FOR_LOCAL_USE
POSTGRES_DB=forge
POSTGRES_PORT=55432

# --- ForgeMini live run (keys live ONLY in your local .env; .env is git-ignored) ---
# Switch models with scripts/model.sh <provider> <model> instead of editing this by hand.
# FORGE_MODEL_PROVIDER=openai          # openai | moonshot (Kimi) | zai (GLM) | ollama (local) | openai_compatible
# FORGE_MODEL_NAME=YOUR_MODEL_ID
# FORGE_MODEL_BASE_URL=                # optional: each provider has a default; required for openai_compatible
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY   # each provider reads its OWN key variable:
# MOONSHOT_API_KEY=                    #   Kimi
# ZAI_API_KEY=                         #   GLM   (Ollama needs no key)
# FORGE_MODEL_API_KEY=                 # optional override for any provider; leave empty normally
# FORGE_MODEL_TIMEOUT_SECONDS=120      # one LLM call
# FORGE_RUN_TIMEOUT_SECONDS=900        # whole agent run
# FORGE_VERIFY_TIMEOUT_SECONDS=300     # one test-command run inside the Verifier
# FORGE_AGENT_MAX_STEPS=25             # step budget of the agent loop
# FORGE_DATA_DIR=./.forgemini          # patches and transcripts
# FORGE_SANDBOX_IMAGE=python:3.12-slim
# Run cost: the tariff of FORGE_MODEL_NAME in USD per 1M tokens, copied from your provider's price page.
# Without input+output prices tokens are still recorded and `forge report` says "not priced" (never a made-up $0).
# Exception: provider=ollama without prices is an explicit $0 tariff ("local, electricity not counted").
# FORGE_PRICE_INPUT_USD_PER_MILLION=
# FORGE_PRICE_OUTPUT_USD_PER_MILLION=
# FORGE_PRICE_CACHED_INPUT_USD_PER_MILLION=   # optional; without it a call whose cache split is unknown is not priced
# FORGE_PRICE_VERSION=2026-11-22              # free label: when you copied the prices
